# ============================================================================
# 云购生活数仓 · 第 4 周 环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制本文件为 .env（同目录），按需改值。
#   PowerShell:  Copy-Item .env.example .env
#   然后编辑 .env
#
#   ⚠ .env 已在 .gitignore 中排除：绝不提交、绝不打进提交包。
#   ⚠ 不要把真实 Key 写进 docker-compose.yml —— 那里只写 ${VAR} 引用。
#
# 生成随机密钥（推荐，别用下面示例里的弱口令）：
#   docker run --rm python:3.12-slim python -c "import secrets;print(secrets.token_urlsafe(42))"
# ============================================================================

# ---------------- MySQL（Hive 元数据库 + Superset 元数据）----------------
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=hive
MYSQL_PASSWORD=hive
# Superset 连接业务库的只读账号密码（权限最小化：只授 SELECT）
MYSQL_RO_PASSWORD=ydsh_ro_2024

# ---------------- Superset ----------------
# 必填：没有这一项 Superset 会拒绝启动（官方镜像的安全检查）
SUPERSET_SECRET_KEY=CHANGE_ME_please_use_a_random_42_char_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@ydsh.local

# ---------------- ClickHouse（服务层缓存，用户名/库名保持一致）----------------
CLICKHOUSE_USER=ydsh
CLICKHOUSE_PASSWORD=ydsh123

# ---------------- 数据服务 ----------------
# auto = 先用 ClickHouse，连不上自动回落 Hive；也可强制 hive / clickhouse
DATA_BACKEND=auto
# 进程内缓存秒数，0 = 关闭（压测时用 0 测真实后端耗时）
CACHE_TTL=10

# ---------------- 大模型（NL2SQL）----------------
# 留空则 Streamlit 进入"演示模式"（用预置 SQL 跑链路，不调用模型）
# 智谱 GLM-4-Flash（免费）：https://open.bigmodel.cn/
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash-250414

# ---------------- Streamlit 里的 ECharts 脚本地址 ----------------
# 注意：这是"浏览器"去加载的地址，必须能从宿主机访问到
ECHARTS_SRC=http://localhost:8000/assets/echarts.min.js
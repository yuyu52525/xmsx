{
  "ydsh_ads.ads_kpi_overview": {
    "database": "ydsh_ads",
    "table": "ads_kpi_overview",
    "description": "全周期核心 KPI 总览（单行）",
    "rows": 1,
    "columns": [
      {
        "name": "stat_scope",
        "type": "string",
        "comment": "统计范围说明"
      },
      {
        "name": "gmv",
        "type": "double",
        "comment": "GMV = 全部订单实付金额合计（元）"
      },
      {
        "name": "valid_gmv",
        "type": "double",
        "comment": "有效 GMV = 计入营收订单实付合计（元）"
      },
      {
        "name": "order_cnt",
        "type": "int",
        "comment": "订单量（去重订单号）"
      },
      {
        "name": "valid_order_cnt",
        "type": "int",
        "comment": "有效订单量"
      },
      {
        "name": "buyer_cnt",
        "type": "int",
        "comment": "下单用户数（全周期去重）"
      },
      {
        "name": "aov",
        "type": "double",
        "comment": "客单价 = gmv / order_cnt（元）"
      },
      {
        "name": "arpu",
        "type": "double",
        "comment": "ARPU = gmv / buyer_cnt（元/人）"
      },
      {
        "name": "repurchase_rate",
        "type": "double",
        "comment": "复购率 = 下单>=2次用户数 / 下单用户数（0~1）"
      },
      {
        "name": "valid_revenue_rate",
        "type": "double",
        "comment": "有效营收占比 = valid_gmv / gmv（0~1）"
      },
      {
        "name": "cancel_rate",
        "type": "double",
        "comment": "取消率 = 已取消订单数 / 订单量（0~1）"
      },
      {
        "name": "refund_rate",
        "type": "double",
        "comment": "退款中占比 = 退款中订单数 / 订单量（0~1）"
      },
      {
        "name": "avg_order_items",
        "type": "double",
        "comment": "件单价口径：平均每单件数 = 件数 / 订单量"
      },
      {
        "name": "calc_time",
        "type": "string",
        "comment": "计算时间"
      }
    ]
  },

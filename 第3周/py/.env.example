# ============================================================
# 大模型 API 配置模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env（同目录）
#   2. 把 DEEPSEEK_API_KEY 换成你自己的 Key
#   3. .env 已在仓库根目录 .gitignore 中排除，不会被提交
#
# 安全规范（本周要求）：
#   - Key 只放 .env / 系统环境变量，绝不写进 .py 源码
#   - .env 不进 Git；提交前用 `git status` 确认看不到它
#   - 一旦怀疑泄露，立刻在控制台吊销并重新生成
# ============================================================

# --- 大模型（DeepSeek，OpenAI 兼容接口）---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Hive 连接（对应 docker-compose 映射）---
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=hive
# 实测：该镜像用 SASL PLAIN，填 NONE；填 NOSASL 会报 "TSocket read 0 bytes"
HIVE_AUTH=NONE